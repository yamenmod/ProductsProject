# PayPal sandbox credentials
# Copy this to `.env` and fill with your sandbox credentials. DO NOT commit real secrets.
# PayPal sandbox credentials
# Use the sandbox base URL by default. For production change to the live endpoint.
PAYPAL_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret-here
# Optional: override base URL (sandbox vs live). Default used by code is sandbox API.
PAYPAL_BASE_URL=https://api.sandbox.paypal.com
PAYPAL_CURRENCY=USD
FRONTEND_BASE_URL=http://localhost:3000

# Server port (optional)
PORT=5000
# Backend environment variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=surf_products
JWT_SECRET=secret123

# PayPal sandbox credentials
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api.sandbox.paypal.com
PAYPAL_CURRENCY=USD
